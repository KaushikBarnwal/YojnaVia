# Yojnavia Backend Environment Configuration (placeholders only - copy to .env and fill in)

# Required when DEBUG is False. Generate a long random value.
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production

# Defaults to False. Set to True only for local development.
DEBUG=False

# Comma-separated hostnames, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Leave unset to use the local SQLite file (db.sqlite3).
# Example shape: postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=

# Google Gemini API Key for Conversational Intake Extraction
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Sarvam AI Speech-to-Text API (Model: saaras:v4)
# For Marathi (mr-IN) and Hindi (hi-IN) Citizen Voice Intake
# Get an API key from https://sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v4

# -----------------------------------------------------------------------------
# WhatsApp & SMS Notification System Configuration
# -----------------------------------------------------------------------------

# Meta WhatsApp Cloud API (Graph API v20.0)
# Obtain from https://developers.facebook.com/apps/
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=yojnavia_webhook_verify_token_2026

# TRAI DLT Compliant Indian SMS Gateway (TCCCPR 2018)
# Gateways: CDAC Mobile Seva / NIC / Gupshup / Textlocal
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_URL=https://api.sms-gateway.gov.in/v2/send
SMS_SENDER_ID=YOJNAV
SMS_DLT_ENTITY_ID=110155234000001
SMS_DLT_TEMPLATE_ID=110716152300001
